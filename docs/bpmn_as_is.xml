<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Veltri_AS_IS"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler / Veltri BPMN Engine"
                  exporterVersion="5.0.0">

  <!-- Colaboración: Participantes (Pools) -->
  <bpmn:collaboration id="Collaboration_Veltri_AS_IS">
    <bpmn:participant id="Participant_Cliente" name="Cliente Final" processRef="Process_Cliente" />
    <bpmn:participant id="Participant_Veltri_Manual" name="Tienda Veltri Tecnologic (Operación Tradicional Manual)" processRef="Process_Veltri_Manual" />
    <bpmn:messageFlow id="Flow_Msg_1" name="Solicitud de PC / Componentes" sourceRef="Participant_Cliente" targetRef="StartEvent_Solicitud" />
    <bpmn:messageFlow id="Flow_Msg_2" name="Envío de proforma en PDF/texto" sourceRef="Task_Enviar_Proforma" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="Flow_Msg_3" name="Comprobante de pago (Yape/Depósito)" sourceRef="Participant_Cliente" targetRef="Task_Verificar_Pago" />
  </bpmn:collaboration>

  <!-- Proceso Cliente (Caja Negra) -->
  <bpmn:process id="Process_Cliente" isExecutable="false" />

  <!-- Proceso Veltri Operación Manual -->
  <bpmn:process id="Process_Veltri_Manual" name="Proceso de Cotización y Venta Manual (AS-IS)" isExecutable="false">
    
    <!-- Lanes / Carriles de Roles -->
    <bpmn:laneSet id="LaneSet_Veltri">
      <bpmn:lane id="Lane_Ventas" name="Asesor de Ventas (WhatsApp / Mostrador)">
        <bpmn:flowNodeRef>StartEvent_Solicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recibir_Solicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buscar_Precios_Excel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Redactar_Proforma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enviar_Proforma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancelado_Stock</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Almacen" name="Encargado de Almacén">
        <bpmn:flowNodeRef>Task_Verificar_Stock_Fisico</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tecnico" name="Técnico Ensamblador">
        <bpmn:flowNodeRef>Task_Validar_Compatibilidad_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Compatibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ensamblar_Equipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Pedido_Despachado</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Administracion" name="Cajero / Administración">
        <bpmn:flowNodeRef>Task_Verificar_Pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar_Pedido_Cuaderno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Fraude_Pago</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Evento de Inicio -->
    <bpmn:startEvent id="StartEvent_Solicitud" name="Consulta recibida">
      <bpmn:outgoing>Seq_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tareas de Ventas -->
    <bpmn:userTask id="Task_Recibir_Solicitud" name="Tipificar requerimiento y presupuesto">
      <bpmn:incoming>Seq_1</bpmn:incoming>
      <bpmn:incoming>Seq_Incompatible_Loop</bpmn:incoming>
      <bpmn:outgoing>Seq_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Buscar_Precios_Excel" name="Consultar precios en Excel desactualizado">
      <bpmn:incoming>Seq_2</bpmn:incoming>
      <bpmn:outgoing>Seq_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tarea de Almacén -->
    <bpmn:userTask id="Task_Verificar_Stock_Fisico" name="Consultar stock físico en almacén">
      <bpmn:incoming>Seq_3</bpmn:incoming>
      <bpmn:outgoing>Seq_4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Compuerta Stock -->
    <bpmn:exclusiveGateway id="Gateway_Stock" name="¿Piezas disponibles?">
      <bpmn:incoming>Seq_4</bpmn:incoming>
      <bpmn:outgoing>Seq_Stock_Si</bpmn:outgoing>
      <bpmn:outgoing>Seq_Stock_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Cancelado_Stock" name="Venta perdida por falta de stock">
      <bpmn:incoming>Seq_Stock_No</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tarea Técnico: Compatibilidad -->
    <bpmn:userTask id="Task_Validar_Compatibilidad_Manual" name="Verificar socket y fuente en Google/manuales">
      <bpmn:incoming>Seq_Stock_Si</bpmn:incoming>
      <bpmn:outgoing>Seq_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Compatibilidad" name="¿Componentes compatibles?">
      <bpmn:incoming>Seq_5</bpmn:incoming>
      <bpmn:outgoing>Seq_Compat_Si</bpmn:outgoing>
      <bpmn:outgoing>Seq_Incompatible_Loop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tarea Ventas: Proforma -->
    <bpmn:userTask id="Task_Redactar_Proforma" name="Calcular a mano IGV y redactar proforma">
      <bpmn:incoming>Seq_Compat_Si</bpmn:incoming>
      <bpmn:outgoing>Seq_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sendTask id="Task_Enviar_Proforma" name="Enviar cotización al cliente">
      <bpmn:incoming>Seq_6</bpmn:incoming>
      <bpmn:outgoing>Seq_7</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Tareas de Administración: Pagos -->
    <bpmn:userTask id="Task_Verificar_Pago" name="Revisar captura de Yape/Banco en app móvil">
      <bpmn:incoming>Seq_7</bpmn:incoming>
      <bpmn:outgoing>Seq_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Pago" name="¿Monto exacto y acreditado?">
      <bpmn:incoming>Seq_8</bpmn:incoming>
      <bpmn:outgoing>Seq_Pago_Si</bpmn:outgoing>
      <bpmn:outgoing>Seq_Pago_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Fraude_Pago" name="Cancelado por discrepancia de pago">
      <bpmn:incoming>Seq_Pago_No</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_Registrar_Pedido_Cuaderno" name="Registrar pedido en cuaderno contable">
      <bpmn:incoming>Seq_Pago_Si</bpmn:incoming>
      <bpmn:outgoing>Seq_9</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tarea Técnico: Ensamble -->
    <bpmn:userTask id="Task_Ensamblar_Equipo" name="Separar piezas físicas y ensamblar PC">
      <bpmn:incoming>Seq_9</bpmn:incoming>
      <bpmn:outgoing>Seq_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Pedido_Despachado" name="PC despachada al cliente">
      <bpmn:incoming>Seq_10</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Secuencias de Flujo -->
    <bpmn:sequenceFlow id="Seq_1" sourceRef="StartEvent_Solicitud" targetRef="Task_Recibir_Solicitud" />
    <bpmn:sequenceFlow id="Seq_2" sourceRef="Task_Recibir_Solicitud" targetRef="Task_Buscar_Precios_Excel" />
    <bpmn:sequenceFlow id="Seq_3" sourceRef="Task_Buscar_Precios_Excel" targetRef="Task_Verificar_Stock_Fisico" />
    <bpmn:sequenceFlow id="Seq_4" sourceRef="Task_Verificar_Stock_Fisico" targetRef="Gateway_Stock" />
    <bpmn:sequenceFlow id="Seq_Stock_Si" name="Sí hay stock" sourceRef="Gateway_Stock" targetRef="Task_Validar_Compatibilidad_Manual" />
    <bpmn:sequenceFlow id="Seq_Stock_No" name="Agotado" sourceRef="Gateway_Stock" targetRef="EndEvent_Cancelado_Stock" />
    <bpmn:sequenceFlow id="Seq_5" sourceRef="Task_Validar_Compatibilidad_Manual" targetRef="Gateway_Compatibilidad" />
    <bpmn:sequenceFlow id="Seq_Compat_Si" name="Compatible" sourceRef="Gateway_Compatibilidad" targetRef="Task_Redactar_Proforma" />
    <bpmn:sequenceFlow id="Seq_Incompatible_Loop" name="Conflicto de piezas" sourceRef="Gateway_Compatibilidad" targetRef="Task_Recibir_Solicitud" />
    <bpmn:sequenceFlow id="Seq_6" sourceRef="Task_Redactar_Proforma" targetRef="Task_Enviar_Proforma" />
    <bpmn:sequenceFlow id="Seq_7" sourceRef="Task_Enviar_Proforma" targetRef="Task_Verificar_Pago" />
    <bpmn:sequenceFlow id="Seq_8" sourceRef="Task_Verificar_Pago" targetRef="Gateway_Pago" />
    <bpmn:sequenceFlow id="Seq_Pago_Si" name="Pago conforme" sourceRef="Gateway_Pago" targetRef="Task_Registrar_Pedido_Cuaderno" />
    <bpmn:sequenceFlow id="Seq_Pago_No" name="Discrepancia" sourceRef="Gateway_Pago" targetRef="EndEvent_Fraude_Pago" />
    <bpmn:sequenceFlow id="Seq_9" sourceRef="Task_Registrar_Pedido_Cuaderno" targetRef="Task_Ensamblar_Equipo" />
    <bpmn:sequenceFlow id="Seq_10" sourceRef="Task_Ensamblar_Equipo" targetRef="EndEvent_Pedido_Despachado" />

  </bpmn:process>

