        <dc:Bounds x="1290" y="730" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Ensamblar_Equipo_di" bpmnElement="Task_Ensamblar_Equipo">
        <dc:Bounds x="1290" y="570" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Pedido_Despachado_di" bpmnElement="EndEvent_Pedido_Despachado">
