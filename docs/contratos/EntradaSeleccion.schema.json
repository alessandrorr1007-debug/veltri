{
  "additionalProperties": false,
  "description": "Selección explícita con tenant del contexto confiable.",
  "properties": {
    "tenant_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "seleccion": {
      "maxProperties": 90,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Z0-9]+(?:-[A-Z0-9]+)+$": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "maxLength": 80
      },
      "title": "Seleccion",
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "seleccion"
  ],
  "title": "EntradaSeleccion",
  "type": "object"
}
