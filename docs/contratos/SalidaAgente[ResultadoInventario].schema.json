{
  "$defs": {
    "FaltanteStock": {
      "additionalProperties": false,
      "description": "Faltante comprobado para una cantidad explícita.",
      "properties": {
        "sku": {
          "maxLength": 80,
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
          "title": "Sku",
          "type": "string"
        },
        "solicitado": {
          "exclusiveMinimum": 0,
          "title": "Solicitado",
          "type": "integer"
        },
        "disponible": {
          "minimum": 0,
          "title": "Disponible",
          "type": "integer"
        },
        "motivo": {
          "const": "stock_insuficiente",
          "title": "Motivo",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "solicitado",
        "disponible",
        "motivo"
      ],
      "title": "FaltanteStock",
      "type": "object"
    },
    "PlanModelo": {
      "additionalProperties": false,
      "description": "Solo intención y puntuaciones no calibradas; nunca montos ni autorizaciones.",
      "properties": {
        "accion": {
          "enum": [
            "armar",
            "cotizar",
            "compatibilidad",
            "stock",
            "pago",
            "pedido",
            "seguimiento",
            "informacion",
            "desconocida"
          ],
          "title": "Accion",
          "type": "string"
        },
        "p": {
          "maximum": 1,
          "minimum": 0,
          "title": "P",
          "type": "number"
        },
        "c": {
          "maximum": 1,
          "minimum": 0,
          "title": "C",
          "type": "number"
        }
      },
      "required": [
        "accion",
        "p",
        "c"
      ],
      "title": "PlanModelo",
      "type": "object"
    },
    "ResultadoInventario": {
      "additionalProperties": false,
      "description": "Stock y sugerencias, sin reemplazar productos ni aprobar una PC.",
      "properties": {
        "stock": {
          "$ref": "#/$defs/ResultadoStock"
        },
        "alternativas": {
          "patternProperties": {
            "^[A-Z0-9]+(?:-[A-Z0-9]+)+$": {
              "items": {
                "maxLength": 80,
                "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "propertyNames": {
            "maxLength": 80
          },
          "title": "Alternativas",
          "type": "object"
        }
      },
      "required": [
        "stock",
        "alternativas"
      ],
      "title": "ResultadoInventario",
      "type": "object"
    },
    "ResultadoStock": {
      "additionalProperties": false,
      "description": "Stock disponible y revisión obligatoria cuando hay faltantes.",
      "properties": {
        "disponible": {
          "title": "Disponible",
          "type": "boolean"
        },
        "hitl_requerido": {
          "title": "Hitl Requerido",
          "type": "boolean"
        },
        "faltantes": {
          "items": {
            "$ref": "#/$defs/FaltanteStock"
          },
          "title": "Faltantes",
          "type": "array"
        },
        "fuente": {
          "const": "data/catalogo.json",
          "title": "Fuente",
          "type": "string"
        }
      },
      "required": [
        "disponible",
        "hitl_requerido",
        "faltantes",
        "fuente"
      ],
      "title": "ResultadoStock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agente": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6",
        "A7",
        "A8"
      ],
      "title": "Agente",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/PlanModelo"
    },
    "origen_puntuacion": {
      "enum": [
        "prueba_no_calibrada",
        "modelo_no_calibrado"
      ],
      "title": "Origen Puntuacion",
      "type": "string"
    },
    "resultado": {
      "$ref": "#/$defs/ResultadoInventario"
    }
  },
  "required": [
    "agente",
    "tenant_id",
    "plan",
    "origen_puntuacion",
    "resultado"
  ],
  "title": "SalidaAgente[ResultadoInventario]",
  "type": "object"
}
