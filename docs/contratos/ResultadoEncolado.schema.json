{
  "$defs": {
    "BorradorPedido": {
      "additionalProperties": false,
      "description": "El contrato impide representar un borrador como pedido confirmado.",
      "properties": {
        "clave": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Clave",
          "type": "string"
        },
        "estado": {
          "const": "borrador_demo",
          "title": "Estado",
          "type": "string"
        },
        "seleccion": {
          "maxProperties": 90,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Z0-9]+(?:-[A-Z0-9]+)+$": {
              "exclusiveMinimum": 0,
              "type": "integer"
            }
          },
          "propertyNames": {
            "maxLength": 80
          },
          "title": "Seleccion",
          "type": "object"
        },
        "hitl_requerido": {
          "const": true,
          "title": "Hitl Requerido",
          "type": "boolean"
        }
      },
      "required": [
        "clave",
        "estado",
        "seleccion",
        "hitl_requerido"
      ],
      "title": "BorradorPedido",
      "type": "object"
    },
    "EvidenciaCotizacion": {
      "additionalProperties": false,
      "description": "Simulación de cotización y sus impedimentos técnicos y de stock.",
      "properties": {
        "tipo": {
          "const": "cotizacion",
          "title": "Tipo",
          "type": "string"
        },
        "resultado": {
          "$ref": "#/$defs/ResultadoCotizacion"
        }
      },
      "required": [
        "tipo",
        "resultado"
      ],
      "title": "EvidenciaCotizacion",
      "type": "object"
    },
    "EvidenciaInformacion": {
      "additionalProperties": false,
      "description": "Fuentes permitidas para una consulta informativa, sin autorización comercial.",
      "properties": {
        "tipo": {
          "const": "informacion",
          "title": "Tipo",
          "type": "string"
        },
        "fuentes": {
          "items": {
            "enum": [
              "data/catalogo.json",
              "data/compatibilidad.json",
              "data/politicas.md"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Fuentes",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "fuentes"
      ],
      "title": "EvidenciaInformacion",
      "type": "object"
    },
    "EvidenciaLimitacion": {
      "additionalProperties": false,
      "description": "Impedimentos explícitos del flujo; nunca autorizan una operación.",
      "properties": {
        "tipo": {
          "const": "limitacion",
          "title": "Tipo",
          "type": "string"
        },
        "motivos": {
          "items": {
            "enum": [
              "parametros_requeridos",
              "parametros_no_corresponden",
              "intencion_desconocida",
              "sin_configuracion_en_rango",
              "borrador_no_encontrado",
              "seguimiento_solo_demo",
              "conocimiento_no_disponible"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Motivos",
          "type": "array"
        },
        "fuentes": {
          "items": {
            "enum": [
              "data/catalogo.json",
              "data/compatibilidad.json",
              "data/politicas.md"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Fuentes",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "motivos",
        "fuentes"
      ],
      "title": "EvidenciaLimitacion",
      "type": "object"
    },
    "EvidenciaPago": {
      "additionalProperties": false,
      "description": "Comparación de importes que no acredita un pago bancario.",
      "properties": {
        "tipo": {
          "const": "pago",
          "title": "Tipo",
          "type": "string"
        },
        "resultado": {
          "$ref": "#/$defs/ResultadoPago"
        }
      },
      "required": [
        "tipo",
        "resultado"
      ],
      "title": "EvidenciaPago",
      "type": "object"
    },
    "EvidenciaPedido": {
      "additionalProperties": false,
      "description": "Un borrador nunca equivale a un pedido confirmado.",
      "properties": {
        "tipo": {
          "const": "pedido",
          "title": "Tipo",
          "type": "string"
        },
        "resultado": {
          "$ref": "#/$defs/ResultadoPedido"
        }
      },
      "required": [
        "tipo",
        "resultado"
      ],
      "title": "EvidenciaPedido",
      "type": "object"
    },
    "EvidenciaStock": {
      "additionalProperties": false,
      "description": "Stock comprobado por la herramienta, no una estimación del modelo.",
      "properties": {
        "tipo": {
          "const": "stock",
          "title": "Tipo",
          "type": "string"
        },
        "resultado": {
          "$ref": "#/$defs/ResultadoStock"
        }
      },
      "required": [
        "tipo",
        "resultado"
      ],
      "title": "EvidenciaStock",
      "type": "object"
    },
    "EvidenciaTecnica": {
      "additionalProperties": false,
      "description": "Restricciones técnicas y evidencia de fabricante pendiente.",
      "properties": {
        "tipo": {
          "const": "tecnico",
          "title": "Tipo",
          "type": "string"
        },
        "resultado": {
          "$ref": "#/$defs/ResultadoTecnico"
        }
      },
      "required": [
        "tipo",
        "resultado"
      ],
      "title": "EvidenciaTecnica",
      "type": "object"
    },
    "FaltanteStock": {
      "additionalProperties": false,
      "description": "Faltante comprobado para una cantidad explícita.",
      "properties": {
        "sku": {
          "maxLength": 80,
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
          "title": "Sku",
          "type": "string"
        },
        "solicitado": {
          "exclusiveMinimum": 0,
          "title": "Solicitado",
          "type": "integer"
        },
        "disponible": {
          "minimum": 0,
          "title": "Disponible",
          "type": "integer"
        },
        "motivo": {
          "const": "stock_insuficiente",
          "title": "Motivo",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "solicitado",
        "disponible",
        "motivo"
      ],
      "title": "FaltanteStock",
      "type": "object"
    },
    "LineaCotizacion": {
      "additionalProperties": false,
      "description": "Una línea con importes calculados y referencia al SKU de origen.",
      "properties": {
        "sku": {
          "maxLength": 80,
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
          "title": "Sku",
          "type": "string"
        },
        "cantidad": {
          "exclusiveMinimum": 0,
          "title": "Cantidad",
          "type": "integer"
        },
        "precio_unitario_centimos": {
          "exclusiveMinimum": 0,
          "title": "Precio Unitario Centimos",
          "type": "integer"
        },
        "subtotal_centimos": {
          "exclusiveMinimum": 0,
          "title": "Subtotal Centimos",
          "type": "integer"
        },
        "fuente": {
          "pattern": "^data/catalogo\\.json#[A-Z0-9-]+$",
          "title": "Fuente",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "cantidad",
        "precio_unitario_centimos",
        "subtotal_centimos",
        "fuente"
      ],
      "title": "LineaCotizacion",
      "type": "object"
    },
    "ResolucionRevision": {
      "additionalProperties": false,
      "description": "Operador sintético y motivos enumerados; no admite comentarios con PII.",
      "properties": {
        "accion": {
          "enum": [
            "aprobar_demo",
            "rechazar",
            "solicitar_correccion"
          ],
          "title": "Accion",
          "type": "string"
        },
        "revisor": {
          "pattern": "^demo_[a-z]{1,32}$",
          "title": "Revisor",
          "type": "string"
        },
        "motivo": {
          "enum": [
            "informacion_verificada",
            "revision_rechazada",
            "requiere_correccion"
          ],
          "title": "Motivo",
          "type": "string"
        }
      },
      "required": [
        "accion",
        "revisor",
        "motivo"
      ],
      "title": "ResolucionRevision",
      "type": "object"
    },
    "ResultadoCotizacion": {
      "additionalProperties": false,
      "description": "Simulación de cotización; nunca concede autorización comercial.",
      "properties": {
        "moneda": {
          "const": "PEN",
          "title": "Moneda",
          "type": "string"
        },
        "naturaleza": {
          "const": "demostracion_sintetica",
          "title": "Naturaleza",
          "type": "string"
        },
        "lineas": {
          "items": {
            "$ref": "#/$defs/LineaCotizacion"
          },
          "maxItems": 90,
          "minItems": 1,
          "title": "Lineas",
          "type": "array"
        },
        "total_centimos": {
          "exclusiveMinimum": 0,
          "title": "Total Centimos",
          "type": "integer"
        },
        "sobre_presupuesto": {
          "title": "Sobre Presupuesto",
          "type": "boolean"
        },
        "stock": {
          "$ref": "#/$defs/ResultadoStock"
        },
        "tecnico": {
          "$ref": "#/$defs/ResultadoTecnico"
        },
        "hitl_requerido": {
          "const": true,
          "title": "Hitl Requerido",
          "type": "boolean"
        },
        "genera_proforma": {
          "const": false,
          "title": "Genera Proforma",
          "type": "boolean"
        },
        "bloqueos": {
          "items": {
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9_]*(?::[A-Za-z0-9_-]+)?$",
            "type": "string"
          },
          "title": "Bloqueos",
          "type": "array"
        },
        "aviso": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Aviso",
          "type": "string"
        }
      },
      "required": [
        "moneda",
        "naturaleza",
        "lineas",
        "total_centimos",
        "sobre_presupuesto",
        "stock",
        "tecnico",
        "hitl_requerido",
        "genera_proforma",
        "bloqueos",
        "aviso"
      ],
      "title": "ResultadoCotizacion",
      "type": "object"
    },
    "ResultadoDecision": {
      "additionalProperties": false,
      "description": "Destino verificable: una ruta ejecutar todavía no ejecuta herramientas.",
      "properties": {
        "opcion": {
          "enum": [
            "informar",
            "consultar_stock",
            "cotizar",
            "validar_compatibilidad",
            "comparar_pago",
            "registrar_borrador"
          ],
          "title": "Opcion",
          "type": "string"
        },
        "p": {
          "maximum": 1,
          "minimum": 0,
          "title": "P",
          "type": "number"
        },
        "c": {
          "maximum": 1,
          "minimum": 0,
          "title": "C",
          "type": "number"
        },
        "origen_puntuacion": {
          "const": "prueba_no_calibrada",
          "title": "Origen Puntuacion",
          "type": "string"
        },
        "destino": {
          "enum": [
            "ejecutar",
            "revision_humana",
            "escalar"
          ],
          "title": "Destino",
          "type": "string"
        },
        "hitl_requerido": {
          "title": "Hitl Requerido",
          "type": "boolean"
        },
        "bloqueos": {
          "items": {
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9_]*(?::[A-Za-z0-9_-]+)?$",
            "type": "string"
          },
          "title": "Bloqueos",
          "type": "array"
        },
        "motivos": {
          "items": {
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9_]*(?::[A-Za-z0-9_-]+)?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Motivos",
          "type": "array"
        },
        "fuentes": {
          "items": {
            "enum": [
              "data/catalogo.json",
              "data/compatibilidad.json",
              "data/politicas.md"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Fuentes",
          "type": "array"
        },
        "hash_evidencia": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Hash Evidencia",
          "type": "string"
        },
        "accion_ejecutada": {
          "const": false,
          "default": false,
          "title": "Accion Ejecutada",
          "type": "boolean"
        }
      },
      "required": [
        "opcion",
        "p",
        "c",
        "origen_puntuacion",
        "destino",
        "hitl_requerido",
        "bloqueos",
        "motivos",
        "fuentes",
        "hash_evidencia"
      ],
      "title": "ResultadoDecision",
      "type": "object"
    },
    "ResultadoPago": {
      "additionalProperties": false,
      "description": "Comparación de importes, aún sin conciliación bancaria.",
      "properties": {
        "montos_coinciden": {
          "title": "Montos Coinciden",
          "type": "boolean"
        },
        "diferencia_centimos": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Diferencia Centimos"
        },
        "estado": {
          "const": "no_conciliado",
          "title": "Estado",
          "type": "string"
        },
        "hitl_requerido": {
          "const": true,
          "title": "Hitl Requerido",
          "type": "boolean"
        },
        "motivos": {
          "items": {
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9_]*(?::[A-Za-z0-9_-]+)?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Motivos",
          "type": "array"
        }
      },
      "required": [
        "montos_coinciden",
        "diferencia_centimos",
        "estado",
        "hitl_requerido",
        "motivos"
      ],
      "title": "ResultadoPago",
      "type": "object"
    },
    "ResultadoPedido": {
      "additionalProperties": false,
      "description": "Resultado idempotente del registro en memoria.",
      "properties": {
        "duplicado": {
          "title": "Duplicado",
          "type": "boolean"
        },
        "registros_creados": {
          "maximum": 1,
          "minimum": 0,
          "title": "Registros Creados",
          "type": "integer"
        },
        "pedido": {
          "$ref": "#/$defs/BorradorPedido"
        }
      },
      "required": [
        "duplicado",
        "registros_creados",
        "pedido"
      ],
      "title": "ResultadoPedido",
      "type": "object"
    },
    "ResultadoStock": {
      "additionalProperties": false,
      "description": "Stock disponible y revisión obligatoria cuando hay faltantes.",
      "properties": {
        "disponible": {
          "title": "Disponible",
          "type": "boolean"
        },
        "hitl_requerido": {
          "title": "Hitl Requerido",
          "type": "boolean"
        },
        "faltantes": {
          "items": {
            "$ref": "#/$defs/FaltanteStock"
          },
          "title": "Faltantes",
          "type": "array"
        },
        "fuente": {
          "const": "data/catalogo.json",
          "title": "Fuente",
          "type": "string"
        }
      },
      "required": [
        "disponible",
        "hitl_requerido",
        "faltantes",
        "fuente"
      ],
      "title": "ResultadoStock",
      "type": "object"
    },
    "ResultadoTecnico": {
      "additionalProperties": false,
      "description": "Compatibilidad de datos separada de aprobación técnica real.",
      "properties": {
        "sin_conflictos_datos": {
          "title": "Sin Conflictos Datos",
          "type": "boolean"
        },
        "aprobado_tecnicamente": {
          "const": false,
          "title": "Aprobado Tecnicamente",
          "type": "boolean"
        },
        "hitl_requerido": {
          "const": true,
          "title": "Hitl Requerido",
          "type": "boolean"
        },
        "conflictos": {
          "items": {
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9_]*(?::[A-Za-z0-9_-]+)?$",
            "type": "string"
          },
          "title": "Conflictos",
          "type": "array"
        },
        "pendientes": {
          "items": {
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9_]*(?::[A-Za-z0-9_-]+)?$",
            "type": "string"
          },
          "title": "Pendientes",
          "type": "array"
        },
        "potencia_estimada_w": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Potencia Estimada W"
        },
        "fuente": {
          "const": "data/compatibilidad.json",
          "title": "Fuente",
          "type": "string"
        }
      },
      "required": [
        "sin_conflictos_datos",
        "aprobado_tecnicamente",
        "hitl_requerido",
        "conflictos",
        "pendientes",
        "potencia_estimada_w",
        "fuente"
      ],
      "title": "ResultadoTecnico",
      "type": "object"
    },
    "Revision": {
      "additionalProperties": false,
      "description": "Solicitud y evidencia conservadas como instantánea para revisión local.",
      "properties": {
        "id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "solicitud": {
          "$ref": "#/$defs/SolicitudDecision"
        },
        "decision": {
          "$ref": "#/$defs/ResultadoDecision"
        },
        "estado": {
          "enum": [
            "pendiente",
            "escalada",
            "aprobada_demo",
            "rechazada",
            "correccion_solicitada"
          ],
          "title": "Estado",
          "type": "string"
        },
        "resolucion": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolucionRevision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "accion_ejecutada": {
          "const": false,
          "default": false,
          "title": "Accion Ejecutada",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "solicitud",
        "decision",
        "estado"
      ],
      "title": "Revision",
      "type": "object"
    },
    "SolicitudDecision": {
      "additionalProperties": false,
      "description": "Puntajes explícitamente no calibrados y evidencia acorde a la opción.",
      "properties": {
        "opcion": {
          "enum": [
            "informar",
            "consultar_stock",
            "cotizar",
            "validar_compatibilidad",
            "comparar_pago",
            "registrar_borrador"
          ],
          "title": "Opcion",
          "type": "string"
        },
        "p": {
          "maximum": 1,
          "minimum": 0,
          "title": "P",
          "type": "number"
        },
        "c": {
          "maximum": 1,
          "minimum": 0,
          "title": "C",
          "type": "number"
        },
        "origen_puntuacion": {
          "const": "prueba_no_calibrada",
          "title": "Origen Puntuacion",
          "type": "string"
        },
        "evidencia": {
          "discriminator": {
            "mapping": {
              "cotizacion": "#/$defs/EvidenciaCotizacion",
              "informacion": "#/$defs/EvidenciaInformacion",
              "limitacion": "#/$defs/EvidenciaLimitacion",
              "pago": "#/$defs/EvidenciaPago",
              "pedido": "#/$defs/EvidenciaPedido",
              "stock": "#/$defs/EvidenciaStock",
              "tecnico": "#/$defs/EvidenciaTecnica"
            },
            "propertyName": "tipo"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EvidenciaInformacion"
            },
            {
              "$ref": "#/$defs/EvidenciaStock"
            },
            {
              "$ref": "#/$defs/EvidenciaCotizacion"
            },
            {
              "$ref": "#/$defs/EvidenciaTecnica"
            },
            {
              "$ref": "#/$defs/EvidenciaPago"
            },
            {
              "$ref": "#/$defs/EvidenciaPedido"
            },
            {
              "$ref": "#/$defs/EvidenciaLimitacion"
            }
          ],
          "title": "Evidencia"
        }
      },
      "required": [
        "opcion",
        "p",
        "c",
        "origen_puntuacion",
        "evidencia"
      ],
      "title": "SolicitudDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "La misma evidencia produce una única revisión por tenant.",
  "properties": {
    "duplicado": {
      "title": "Duplicado",
      "type": "boolean"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    }
  },
  "required": [
    "duplicado",
    "revision"
  ],
  "title": "ResultadoEncolado",
  "type": "object"
}
