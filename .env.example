# Copia este archivo a .env y completa los valores. NUNCA subas .env.
GOOGLE_API_KEY=
LLM_PROVIDER=gemini
# Escribe aquí un nombre de modelo vigente (verifícalo en la documentación de Google)
LLM_MODEL=
# 1 = usar MockLLM (sin red), 0 = usar el modelo real
USE_MOCK_LLM=1
TENANT_ID=veltri_tecnologic_pe
CHROMA_DIR=./chroma_db

# Observabilidad solo para demo sintética de confianza. Ambos opt-in apagados.
VELTRI_TRACING_ENABLED=0
VELTRI_TRACING_SYNTHETIC_ONLY=1
VELTRI_TRACING_ALLOW_EXTERNAL=0
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_PROJECT=veltri-semana10-demo
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
